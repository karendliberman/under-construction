{
  "name": "under-construction",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev --workspace=@uc/web",
    "build": "npm run build --workspace=@uc/web",
    "typecheck": "npm run typecheck --workspace=@uc/web",
    "db:generate": "npm run generate --workspace=@uc/db",
    "db:migrate": "npm run migrate --workspace=@uc/db"
  }
}
