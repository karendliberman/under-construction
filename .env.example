# Copy to .env.local and fill in. NOTHING real goes in git.

# --- both services ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- web service only ---
# Public origin, used to build set-password links. Leave unset locally and the
# app falls back to the request's forwarded host.
APP_URL=
SESSION_SECRET=generate-with-openssl-rand-base64-32
RESEND_API_KEY=

# --- spend controls (both services) ---
# Set BEFORE the first API call, not after the first surprising bill. The
# Anthropic console gives an alert; the hard refusal lives in these.
# Blank means "use the built-in default", so an unset value is safe.
SPEND_CAP_WINDOW_USD=300
SPEND_WINDOW_DAYS=30

# Web service only: per-user throttle, so one enthusiastic user is told why
# rather than quietly consuming the account's whole window.
GENERATIONS_PER_USER_PER_DAY=20

# --- worker service only ---
# Circuit breaker on a single motion. ~40 agent runs at $5/$25 per MTok puts a
# normal one in the $20-40 range, so this catches a loop without tripping on a
# long complaint.
SPEND_CAP_PER_GENERATION_USD=50

# How often the worker asks the queue for work. This is a DATABASE BILLING
# decision, not a latency one: Neon charges for time the compute is awake, and
# its free plan only sleeps after 5 quiet minutes. Anything under 5 min keeps
# it awake around the clock. A draft takes 45 to 90 minutes, so queue delay is
# invisible either way. 3 for local testing, 900 when idle.
WORKER_POLL_SECONDS=3

# The web service never needs this key. Keep it that way.
ANTHROPIC_API_KEY=

# Git SHA, used for generations.playbook_version. Render injects this at build
# time; set it by hand for local runs.
GIT_SHA=local
